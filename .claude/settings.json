{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path | select(endswith(\".rs\"))' | xargs -r rustfmt --edition 2024"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "jjagent@jjagent": false
  }
}
