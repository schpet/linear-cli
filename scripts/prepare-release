#!/usr/bin/env bash
# Prepare and validate a stable or prerelease version without publishing it.
set -euo pipefail
version=${1:?usage: prepare-release VERSION}
if [[ "$version" == latest ]]; then
    version=$(changelog version latest)
fi

# Require versioned notes: cargo-dist otherwise invents a "Version ..." title.
changelog entry "$version" >/dev/null
probe_dir=$(mktemp -d)
trap 'rm -f "$probe_dir/Cargo.toml" "$probe_dir/plan.json"; rmdir "$probe_dir"' EXIT
cp Cargo.toml "$probe_dir/Cargo.toml"
svbump write "$version" workspace.package.version "$probe_dir/Cargo.toml"
actual=$(svbump read workspace.package.version "$probe_dir/Cargo.toml")
if [[ "$actual" != "$version" ]]; then
    echo "svbump wrote '$actual' instead of '$version'; update svbump before releasing" >&2
    exit 1
fi
svbump write "$version" workspace.package.version Cargo.toml
cargo update --workspace
# Limit Git's working tree to this checkout, including in jj workspaces.
GIT_WORK_TREE="$PWD" dist plan --tag "v$version" --output-format=json > "$probe_dir/plan.json"
if ! jq -e --arg version "$version" '
    .announcement_tag == ("v" + $version)
    and (.announcement_title | startswith($version + " - "))
    and (.announcement_is_prerelease == ($version | split("+")[0] | contains("-")))
    and (.releases | length > 0)
    and ([.releases[].app_version] | all(. == $version))
' "$probe_dir/plan.json" >/dev/null; then
    echo "cargo-dist release metadata does not match v$version and its dated changelog heading" >&2
    jq '{announcement_tag, announcement_title, announcement_is_prerelease}' "$probe_dir/plan.json" >&2
    exit 1
fi
printf 'Prepared v%s; run just check before tagging.\n' "$version"
