{
  "id": "api-loopback-unauthorized-401",
  "route": "linear api",
  "reason": "Runner smoke case: a scripted 401 body is echoed to stderr with a newline and exit 1; stdout stays empty.",
  "argv": [
    "api",
    "{ viewer { id } }"
  ],
  "stdin": {
    "utf8": ""
  },
  "cwdFixture": "empty",
  "env": {
    "HOME": "{{home}}",
    "XDG_CONFIG_HOME": "{{configHome}}",
    "APPDATA": "{{configHome}}",
    "PATH": "{{bin}}",
    "DENO_DIR": "{{denoDir}}",
    "TZ": "UTC",
    "LANG": "C.UTF-8",
    "LINEAR_IGNORE_ENV_FILE": "1",
    "LINEAR_GRAPHQL_ENDPOINT": "http://127.0.0.1:{{fixturePort}}/graphql",
    "LINEAR_API_KEY": "lin_api_fake"
  },
  "substitutions": [
    "home",
    "configHome",
    "bin",
    "denoDir",
    "fixturePort"
  ],
  "timeoutMs": 20000,
  "outputCapBytes": 4194304,
  "fixtureServer": {
    "path": "/graphql",
    "responses": [
      {
        "status": 401,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "utf8": "{\"errors\":[{\"message\":\"Authentication required, not authenticated\",\"extensions\":{\"type\":\"authentication error\",\"code\":\"AUTHENTICATION_ERROR\"}}]}"
        }
      }
    ],
    "expectedRequests": 1,
    "expectedAuthorization": "lin_api_fake"
  },
  "expected": {
    "exit": {
      "code": 1
    },
    "stdout": {
      "utf8": ""
    },
    "stderr": {
      "utf8": "{\"errors\":[{\"message\":\"Authentication required, not authenticated\",\"extensions\":{\"type\":\"authentication error\",\"code\":\"AUTHENTICATION_ERROR\"}}]}\n"
    },
    "fileEffects": []
  },
  "deviation": null
}
