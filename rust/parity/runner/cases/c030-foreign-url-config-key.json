{
  "id": "c030-foreign-url-config-key",
  "route": "linear milestone list",
  "reason": "Foreign URL with config api_key gets the config-key suggestion",
  "argv": [
    "milestone",
    "list",
    "--project",
    "https://linear.app/beta/project/mobile-app-abc123def456",
    "--json"
  ],
  "stdin": {
    "utf8": ""
  },
  "cwdFixture": "api-key-config",
  "env": {
    "HOME": "{{home}}",
    "XDG_CONFIG_HOME": "{{configHome}}",
    "APPDATA": "{{configHome}}",
    "PATH": "{{bin}}",
    "DENO_DIR": "{{denoDir}}",
    "TZ": "UTC",
    "LANG": "C.UTF-8",
    "LINEAR_IGNORE_ENV_FILE": "1",
    "NO_COLOR": "1",
    "LINEAR_GRAPHQL_ENDPOINT": "http://127.0.0.1:1/graphql"
  },
  "substitutions": [
    "home",
    "configHome",
    "bin",
    "denoDir"
