{
  "id": "issue-attach-signed-upload",
  "route": "linear issue attach",
  "reason": "Issue lookup, fileUpload, signed PUT bytes/headers, and attachmentCreate execute in order with exact final state.",
  "argv": ["issue", "attach", "ABC-1", "note.txt"],
  "stdin": { "utf8": "" },
  "cwdFixture": "attach-small",
  "env": {
    "HOME": "{{home}}",
    "XDG_CONFIG_HOME": "{{configHome}}",
    "APPDATA": "{{configHome}}",
    "PATH": "{{bin}}",
    "DENO_DIR": "{{denoDir}}",
    "TZ": "UTC",
    "LANG": "C.UTF-8",
    "LINEAR_IGNORE_ENV_FILE": "1",
    "LINEAR_GRAPHQL_ENDPOINT": "http://127.0.0.1:{{fixturePort}}/graphql",
    "LINEAR_API_KEY": "lin_api_fake"
  },
  "substitutions": ["home", "configHome", "bin", "denoDir", "fixturePort"],
  "timeoutMs": 30000,
  "outputCapBytes": 4194304,
  "fixtureServer": null,
  "graphql": {
    "path": "/graphql",
    "schemaSha256": "eef86b69c116d6adcb4f3659c29f9eb1407f84846f03cfda0b6096a80df3729a",
    "expectedRequests": 4,
    "initialRecords": {},
    "expectedRecords": {
      "Attachment:a1": {
        "id": "attachment-fake-1",
        "title": "note.txt",
        "url": "https://uploads.linear.app/fake/note.txt"
      }
    },
    "groups": [{
      "mode": "ordered",
      "steps": [
        {
          "kind": "graphql",
          "id": "lookup",
          "operation": {
            "document": "query GetIssueId($id: String!) { issue(id: $id) { id } }",
            "variables": { "id": "ABC-1" }
          },
          "identity": {
            "authorization": "lin_api_fake",
            "userAgent": "schpet-linear-cli/2.6.0",
            "headers": {}
          },
          "response": {
            "kind": "data",
            "data": { "issue": { "id": "issue-fake-uuid" } }
          },
          "effects": []
        },
        {
          "kind": "graphql",
          "id": "file-upload",
          "operation": {
            "document": "mutation FileUpload($contentType: String!, $filename: String!, $size: Int!, $makePublic: Boolean) { fileUpload(contentType: $contentType, filename: $filename, size: $size, makePublic: $makePublic) { success uploadFile { assetUrl uploadUrl headers { key value } } } }",
            "variables": {
              "contentType": "text/plain",
              "filename": "note.txt",
              "size": 13,
              "makePublic": false
            }
          },
          "identity": {
            "authorization": "lin_api_fake",
            "userAgent": "schpet-linear-cli/2.6.0",
            "headers": {}
          },
          "response": {
            "kind": "data",
            "data": {
              "fileUpload": {
                "success": true,
                "uploadFile": {
                  "assetUrl": "https://uploads.linear.app/fake/note.txt",
                  "uploadUrl": "http://127.0.0.1:{{fixturePort}}/signed/upload?token=fake",
                  "headers": [{ "key": "x-upload-token", "value": "fake" }]
                }
              }
            }
          },
          "effects": []
        },
        {
          "kind": "asset",
          "id": "signed-put",
          "method": "PUT",
          "path": "/signed/upload?token=fake",
          "requiredHeaders": {
            "content-type": "text/plain",
            "x-upload-token": "fake"
          },
          "forbiddenHeaders": ["Authorization"],
          "body": { "utf8": "hello upload\n" },
          "response": { "status": 200, "headers": {}, "body": { "utf8": "" } }
        },
        {
          "kind": "graphql",
          "id": "create-attachment",
          "operation": {
            "document": "mutation AttachmentCreate($input: AttachmentCreateInput!) { attachmentCreate(input: $input) { success attachment { id url title } } }",
            "variables": {
              "input": {
                "issueId": "issue-fake-uuid",
                "title": "note.txt",
                "url": "https://uploads.linear.app/fake/note.txt"
              }
            }
          },
          "identity": {
            "authorization": "lin_api_fake",
            "userAgent": "schpet-linear-cli/2.6.0",
            "headers": {}
          },
          "response": {
            "kind": "data",
            "data": {
              "attachmentCreate": {
                "success": true,
                "attachment": {
                  "id": "attachment-fake-1",
                  "url": "https://uploads.linear.app/fake/note.txt",
                  "title": "note.txt"
                }
              }
            }
          },
          "effects": [
            {
              "kind": "put",
              "record": "Attachment:a1",
              "before": { "absent": true },
              "after": {
                "id": "attachment-fake-1",
                "title": "note.txt",
                "url": "https://uploads.linear.app/fake/note.txt"
              }
            }
          ]
        }
      ]
    }]
  },
  "expected": {
    "exit": { "code": 0 },
    "stdout": {
      "utf8": "✓ Uploaded note.txt\n✓ Sidebar link attachment created: note.txt\nhttps://uploads.linear.app/fake/note.txt\n"
    },
    "stderr": { "utf8": "" },
    "fileEffects": []
  },
  "deviation": null
}
